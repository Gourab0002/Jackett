{
  "name": "jackett-worker",
  "version": "1.0.0",
  "description": "Jackett - Torznab proxy for Node.js",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
